# syntax=docker/dockerfile:1
ARG GHOSTWIRE_BASE=ghostwire-base:dev

# ---- Stage 0: compile Go tools ----
FROM golang:1.24-bookworm AS gobuilder
ENV CGO_ENABLED=0 GOTOOLCHAIN=auto
ARG TARGETOS TARGETARCH
ENV GOOS=${TARGETOS} GOARCH=${TARGETARCH}
RUN set -eux; \
    go install github.com/jpillora/chisel@v1.11.5; \
    go install github.com/projectdiscovery/dnsx/cmd/dnsx@v1.2.3; \
    go install github.com/projectdiscovery/httpx/cmd/httpx@v1.9.0; \
    go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@v2.6.6

# ---- Stage 1: final image ----
FROM ${GHOSTWIRE_BASE} AS final
USER root

LABEL org.opencontainers.image.title="ghostwire-net" \
      org.opencontainers.image.description="Network recon, tunneling & traffic analysis" \
      org.opencontainers.image.source="https://github.com/hacktivesec/ghostwire"

ENV GHOST_LABEL=net

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      nmap masscan \
      tcpdump tshark tcpflow ngrep \
      hydra ike-scan onesixtyone snmp \
      sshuttle openvpn wireguard-tools \
      libplist-utils; \
    rm -rf /var/lib/apt/lists/*

RUN "${GHOST_VENV}/bin/pip" install --no-cache-dir \
      scapy impacket

# ---- Go tools from builder stage ----
COPY --from=gobuilder /go/bin/ /usr/local/bin/

# ---- Net helper aliases ----
RUN set -eux; \
    cat > /usr/local/bin/gw-net-scan <<'SH'
#!/usr/bin/env bash
echo "[net] Quick network assessment patterns:"
echo "  nmap -sC -sV -oA scan <target>"
echo "  masscan -p1-1000 <target> --rate=1000"
echo "  dnsx -d domain.com -a -aaaa -cname"
echo "  httpx -l hosts.txt -status-code"
echo "  ike-scan -A <target>"
echo "  onesixtyone <target>"
SH
RUN chmod +x /usr/local/bin/gw-net-scan
RUN cat > /usr/local/bin/gw-net-tunnel <<'SH'
#!/usr/bin/env bash
echo "[net] Tunneling & pivoting patterns:"
echo "  chisel server -p 8080 --reverse"
echo "  chisel client server:8080 R:1080:socks"
echo "  sshuttle -r user@jumpbox 10.0.0.0/8"
echo "  openvpn config.ovpn"
echo "  wg-quick up wg0.conf"
echo "  px nmap -sT target"
SH
RUN chmod +x /usr/local/bin/gw-net-tunnel
RUN cat > /usr/local/bin/gw-net-traffic <<'SH'
#!/usr/bin/env bash
echo "[net] Traffic analysis patterns:"
echo "  tcpdump -i any -w capture.pcap"
echo "  tshark -r capture.pcap -Y http"
echo "  tcpflow -r capture.pcap"
echo "  ngrep -d any -W byline port 80"
SH
RUN chmod +x /usr/local/bin/gw-net-traffic

COPY scripts/ghostwire-net.profile.sh /etc/profile.d/ghostwire-net.sh
RUN echo '. /etc/profile.d/ghostwire-net.sh' >> /home/ghost/.bashrc

# ---- Scoped sudo for capture ----
RUN printf 'ghost ALL=(ALL) NOPASSWD: /usr/sbin/tcpdump, /sbin/ip, /usr/bin/tshark\n' > /etc/sudoers.d/ghost && \
    chmod 0440 /etc/sudoers.d/ghost

USER ghost
WORKDIR /work

HEALTHCHECK --interval=5m --timeout=10s --start-period=20s --retries=3 \
  CMD sh -c 'command -v nmap >/dev/null 2>&1 && command -v tshark >/dev/null 2>&1 || exit 1'

ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["/bin/bash"]
