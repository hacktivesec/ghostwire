# syntax=docker/dockerfile:1
ARG GHOSTWIRE_BASE=ghostwire-base:dev

FROM ${GHOSTWIRE_BASE} AS final
USER root

LABEL org.opencontainers.image.title="ghostwire-wifi" \
      org.opencontainers.image.description="Wireless security toolkit" \
      org.opencontainers.image.source="https://github.com/hacktivesec/ghostwire"

ENV GHOST_LABEL=wifi

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      aircrack-ng reaver pixiewps \
      hcxdumptool hcxtools \
      iw wireless-tools rfkill wpasupplicant \
      tcpdump tshark \
      usbutils kmod; \
    rm -rf /var/lib/apt/lists/*

RUN cat > /usr/local/bin/wifi-mon <<'SH'
#!/usr/bin/env bash
set -euo pipefail
IF="${1:-}"
ACTION="${2:-on}"
[ -n "$IF" ] || { echo "usage: wifi-mon <iface> [on|off]" >&2; exit 2; }
if [ "$ACTION" = "on" ]; then
  sudo rfkill unblock all || true
  sudo ip link set "$IF" down
  sudo iw dev "$IF" set type monitor
  sudo ip link set "$IF" up
  echo "[wifi] $IF -> monitor mode"
else
  sudo rfkill unblock all || true
  sudo ip link set "$IF" down || true
  sudo iw dev "$IF" set type managed || true
  sudo ip link set "$IF" up || true
  echo "[wifi] $IF -> managed mode"
fi
SH
RUN chmod +x /usr/local/bin/wifi-mon

RUN cat > /usr/local/bin/wifi-scan <<'SH'
#!/usr/bin/env bash
set -euo pipefail
IF="${1:-}"
[ -n "$IF" ] || { echo "usage: wifi-scan <mon-iface>" >&2; exit 2; }
echo "[wifi] scanning on $IF (Ctrl-C to stop)"
exec sudo airodump-ng "$IF"
SH
RUN chmod +x /usr/local/bin/wifi-scan

RUN cat > /usr/local/bin/wifi-capture <<'SH'
#!/usr/bin/env bash
set -euo pipefail
IF="${1:-}"; CH="${2:-}"; OUT="${3:-${ENGAGEMENT_DIR:-/shared}/scans/wifi}"
[ -n "$IF" ] || { echo "usage: wifi-capture <mon-iface> [channel] [prefix]" >&2; exit 2; }
mkdir -p "$(dirname "$OUT")"
ts="$(date -u +%F_%H%M%S)"
prefix="${OUT}_$ts"
if [ -n "$CH" ]; then
  exec sudo airodump-ng -w "$prefix" --output-format pcap --channel "$CH" "$IF"
else
  exec sudo airodump-ng -w "$prefix" --output-format pcap "$IF"
fi
SH
RUN chmod +x /usr/local/bin/wifi-capture

COPY scripts/gw-wifi-capture /usr/local/bin/gw-wifi-capture
RUN chmod +x /usr/local/bin/gw-wifi-capture

COPY scripts/ghostwire-wifi.profile.sh /etc/profile.d/ghostwire-wifi.sh
RUN echo '. /etc/profile.d/ghostwire-wifi.sh' >> /home/ghost/.bashrc

RUN printf 'ghost ALL=(ALL) NOPASSWD: /usr/sbin/tcpdump, /sbin/ip, /usr/bin/tshark, /usr/sbin/airmon-ng, /usr/sbin/iw, /usr/bin/airodump-ng, /usr/bin/aireplay-ng, /usr/sbin/rfkill\n' > /etc/sudoers.d/ghost && \
    chmod 0440 /etc/sudoers.d/ghost

USER ghost
WORKDIR /work

HEALTHCHECK --interval=5m --timeout=10s --start-period=10s --retries=3 \
  CMD sh -c 'command -v airodump-ng >/dev/null 2>&1 && command -v aircrack-ng >/dev/null 2>&1 && command -v tshark >/dev/null 2>&1 || exit 1'

ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["/bin/bash"]
